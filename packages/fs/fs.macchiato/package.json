{
  "name": "@nodelib/fs.macchiato",
  "version": "3.0.0",
  "description": "A set of classes for easy testing of built-in structures of FS",
  "license": "MIT",
  "repository": "https://github.com/nodelib/nodelib/tree/master/packages/fs/fs.macchiato",
  "keywords": [
    "NodeLib",
    "fs",
    "FileSystem",
    "file system",
    "mock",
    "stat",
    "dirent"
  ],
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "files": [
    "out/*",
    "!out/*.map",
    "!out/*.spec.*"
  ],
  "main": "out/index.js",
  "typings": "out/index.d.ts",
  "scripts": {
    "clean": "rimraf {tsconfig.tsbuildinfo,out}",
    "lint": "eslint \"src/**/*.ts\" --cache",
    "compile": "tsc -b .",
    "compile:watch": "tsc -b . --watch --sourceMap",
    "test": "mocha \"out/**/*.spec.js\" -s 0",
    "build": "npm run clean && npm run compile && npm run lint && npm test",
    "watch": "npm run clean && npm run compile:watch"
  },
  "devDependencies": {
    "@nodelib-internal/tools.npm-package-exports-linter": "0.0.0",
    "@nodelib-internal/tools.size-limit": "0.0.0",
    "@types/mocha": "10.0.9",
    "@types/node": "^22.20.1",
    "@types/sinon": "17.0.3",
    "eslint": "9.14.0",
    "eslint-config-mrmlnc": "5.0.0",
    "mocha": "10.8.2",
    "rimraf": "6.0.1",
    "sinon": "19.0.2",
    "typescript": "5.7.2"
  }
}
