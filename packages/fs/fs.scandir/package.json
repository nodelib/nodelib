{
  "name": "@nodelib/fs.scandir",
  "version": "4.0.1",
  "type": "module",
  "description": "List files and directories inside the specified directory",
  "license": "MIT",
  "repository": "https://github.com/nodelib/nodelib/tree/master/packages/fs/fs.scandir",
  "keywords": [
    "NodeLib",
    "fs",
    "FileSystem",
    "file system",
    "scandir",
    "readdir",
    "dirent"
  ],
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "files": [
    "out/**",
    "!out/benchmark",
    "!out/**/*.map",
    "!out/**/*.spec.*"
  ],
  "main": "out/index.js",
  "typings": "out/index.d.ts",
  "exports": {
    ".": {
      "default": "./out/index.js"
    },
    "./promises": {
      "default": "./out/scandir-promises.js"
    }
  },
  "scripts": {
    "clean": "rimraf {tsconfig.tsbuildinfo,out}",
    "lint": "eslint \"src/**/*.ts\" --cache",
    "compile": "tsc -b .",
    "compile:watch": "tsc -b . --watch --sourceMap",
    "test": "mocha \"out/**/*.spec.js\" -s 0",
    "build": "npm run clean && npm run compile && npm run lint && npm test",
    "watch": "npm run clean && npm run compile:watch",
    "bench": "npm run bench:sync && npm run bench:async",
    "bench:sync": "hereby bench:sync",
    "bench:async": "hereby bench:async"
  },
  "dependencies": {
    "@nodelib/fs.stat": "4.0.0",
    "run-parallel": "^1.2.0"
  },
  "devDependencies": {
    "@nodelib/fs.macchiato": "3.0.0",
    "@nodelib/fs.scandir.previous": "npm:@nodelib/fs.scandir@3",
    "@nodelib-internal/tools.npm-package-exports-linter": "0.0.0",
    "@nodelib-internal/tools.size-limit": "0.0.0",
    "@types/mocha": "10.0.9",
    "@types/node": "^22.20.1",
    "@types/run-parallel": "^1.1.0",
    "@types/sinon": "17.0.3",
    "bencho": "0.1.1",
    "eslint": "10.7.0",
    "eslint-config-mrmlnc": "6.1.0",
    "execa": "9.5.1",
    "hereby": "1.10.0",
    "mocha": "10.8.2",
    "rimraf": "6.0.1",
    "sinon": "19.0.2",
    "typescript": "6.0.3"
  }
}
